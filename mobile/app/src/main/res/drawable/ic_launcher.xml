<?xml version="1.0" encoding="utf-8"?>
<!-- Simple launcher icon: blue rounded square with a white barcode. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1D4ED8" />
            <corners android:radius="12dp" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item android:left="11dp" android:top="14dp" android:bottom="14dp" android:width="3dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:left="16dp" android:top="14dp" android:bottom="14dp" android:width="2dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:left="20dp" android:top="14dp" android:bottom="14dp" android:width="4dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:left="26dp" android:top="14dp" android:bottom="14dp" android:width="2dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:left="30dp" android:top="14dp" android:bottom="14dp" android:width="3dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:left="35dp" android:top="14dp" android:bottom="14dp" android:width="2dp" android:gravity="left|fill_vertical">
