<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the app updates itself (Updater.kt): download the new APK and hand it to the system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Honeywell: needed to claim the scanner and get each scan as an intent (Scanners.kt); ignored elsewhere -->
    <uses-permission android:name="com.honeywell.decode.permission.DECODE" />

    <queries>
        <package android:name="com.symbol.datawedge" />
        <package android:name="com.intermec.datacollectionservice" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- the camera app writes the photo of a request to the office here (Photos.kt) -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="it.casate.scanner.photo"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
