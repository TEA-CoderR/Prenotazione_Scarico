# Copy to .env on the server and fill in. Never commit .env.

# Public address (DNS A record of prenota.casa-te.com -> Aruba server IP)
DOMAIN=prenota.casa-te.com
APP_URL=https://prenota.casa-te.com

# Database password (long random string)
POSTGRES_PASSWORD=

# Aliyun enterprise mail (阿里云企业邮箱), SMTP over SSL.
# With SMTP_USER empty, mails are only printed to the logs.
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@casa-te.com
SMTP_PASS=
MAIL_FROM=Prenotazione Scarico <noreply@casa-te.com>

# Cloudflare Turnstile (captcha on the booking form). Create a free widget for
# prenota.casa-te.com in the Cloudflare dashboard. Leave both empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local development only (docker compose sets it for the app container)
DATABASE_URL=postgres://postgres@localhost:5432/scarico
